# AGENT 1: Environment Variables Example
# Duplicate this file to .env and fill in the values

# Firebase Config
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here
FIREBASE_DB_URL=https://your-app-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_MSG_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_key
TMDB_API_KEY=your_tmdb_key_if_needed
